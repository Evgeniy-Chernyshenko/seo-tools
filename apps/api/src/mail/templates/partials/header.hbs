<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{headline}}</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { background-color: #f4f4f0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
    .wrapper { max-width: 560px; margin: 40px auto; background: #ffffff; border-radius: 12px; overflow: hidden; border: 1px solid #e8e8e4; }
    .header { padding: 32px 40px 24px; border-bottom: 1px solid #f0f0ec; }
    .logo { font-size: 18px; font-weight: 600; color: #1a1a1a; letter-spacing: -0.3px; }
    .logo span { color: #5b50d6; }
    .body { padding: 36px 40px; }
    .headline { font-size: 22px; font-weight: 600; color: #1a1a1a; margin-bottom: 12px; letter-spacing: -0.3px; }
    .text { font-size: 15px; color: #5a5a5a; line-height: 1.7; margin-bottom: 20px; }
    .code-block { background: #f7f6fe; border: 1px solid #dddaf8; border-radius: 10px; padding: 28px; text-align: center; margin: 28px 0; }
    .code { font-size: 36px; font-weight: 700; color: #3d35b0; letter-spacing: 10px; font-family: 'Courier New', monospace; }
    .code-label { font-size: 12px; color: #8a87c0; margin-top: 8px; text-transform: uppercase; letter-spacing: 0.8px; }
    .warning { background: #fdf8ec; border: 1px solid #f5e4b3; border-radius: 8px; padding: 14px 16px; font-size: 13px; color: #7a5c1a; line-height: 1.6; margin-top: 8px; }
    .warning strong { color: #5a4010; }
    .divider { border: none; border-top: 1px solid #f0f0ec; margin: 28px 0; }
    .footer { padding: 20px 40px 28px; }
    .footer-text { font-size: 12px; color: #aaa; line-height: 1.7; }
    .footer-text a { color: #8a87c0; text-decoration: none; }
  </style>
</head>
<body>
<div class="wrapper">
  <div class="header">
    <div class="logo">{{appNamePart1}}<span>{{appNamePart2}}</span></div>
  </div>
  <div class="body">
    <h1 class="headline">{{headline}}</h1>
