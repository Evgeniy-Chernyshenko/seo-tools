<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{headline}}</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { background-color: #F1F3F5; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
    .wrapper { max-width: 560px; margin: 40px auto; background: #ffffff; border-radius: 12px; overflow: hidden; border: 1px solid #DEE2E6; border-top: 3px solid #339AF0; }
    .header { padding: 24px 40px; border-bottom: 1px solid #F1F3F5; }
    .logo { display:inline-block; line-height:0; text-decoration: none; }
    .body { padding: 40px 40px 32px; }
    .headline { font-size: 20px; font-weight: 600; color: #1E1E1E; margin-bottom: 16px; letter-spacing: -0.2px; }
    .text { font-size: 15px; color: #495057; line-height: 1.65; margin-bottom: 0; }
    .code-block { background: #F8FBFF; border: 1px solid #BDE0FE; border-radius: 10px; padding: 28px 24px; text-align: center; margin: 28px 0; }
    .code { font-size: 40px; font-weight: 700; color: #1864AB; letter-spacing: 12px; text-indent: 12px; font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace; line-height: 1; }
    .notice { font-size: 13px; color: #868E96; line-height: 1.6; margin-top: 24px; padding-top: 20px; border-top: 1px solid #F1F3F5; }
    .notice strong { color: #495057; font-weight: 500; }
    .divider { border: none; border-top: 1px solid #F1F3F5; margin: 0; }
    .footer { padding: 20px 40px; }
    .footer-text { font-size: 12px; color: #ADB5BD; line-height: 1.7; }
    .footer-text a { color: #339AF0; text-decoration: none; }
  </style>
</head>
<body>
<div class="wrapper">
  <div class="header">
    {{> logo}}
  </div>
  <div class="body">
    <h1 class="headline">{{headline}}</h1>
